{
  "name": "@fkn/container",
  "version": "0.1.0",
  "description": "Run a Docker image in a browser tab and make HTTP requests to it.",
  "license": "MIT",
  "repository": "github:Banou26/docker-wasm",
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./vite": {
      "types": "./lib/vite/index.d.ts",
      "default": "./lib/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "bin": {
    "fkn-container": "./lib/vite/cli.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev-wasm-cmd\" \"npm run dev-web\"",
    "dev-wasm-cmd": "nodemon -e go --watch src/proxy --exec \"npm run make-docker\"",
    "dev-wasm": "concurrently \"nodemon -e go --watch src/proxy --exec \\\"npm run make-docker\\\"\"",
    "make-docker": "docker compose run --rm docker-wasm make",
    "build-presets": "./scripts/build-preset-images.sh",
    "verify-presets": "./scripts/verify-preset-images.sh",
    "dev-web": "vite --port 1234",
    "vite-build": "vite build && npm run compress-wasm",
    "build:pages": "WASM_ASSET_BASE=/wasm-assets vite build && node scripts/prepare-pages-build.cjs",
    "build:lib": "node scripts/stage-lib-assets.cjs && vite build --config vite.lib.config.ts && vite build --config vite.node.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-vite.json",
    "vite-build-dev": "vite build --watch",
    "build": "npm run make-docker && vite build && npm run copy-wasm && npm run compress-wasm",
    "typecheck": "tsc --noEmit",
    "copy-wasm": "copyfiles -u 1 dist/*.wasm public/ && copyfiles -u 1 dist/*.wasm build/",
    "compress-wasm": "node scripts/compress-wasm.cjs",
    "publish-wasm-assets": "./scripts/publish-wasm-assets.sh",
    "preview": "vite preview"
  },
  "keywords": [
    "docker",
    "container",
    "webassembly",
    "wasm",
    "browser",
    "vite-plugin",
    "container2wasm"
  ],
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "copyfiles": "^2.4.1",
    "ghostty-web": "^0.4.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "4.110.0",
    "xterm-pty": "0.9.4"
  },
  "dependencies": {
    "@fkn/lib": "^0.5.5",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  }
}
